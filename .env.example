# Supabase — Project Settings > Data API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 브라우저(로그인 폼 등 클라이언트 컴포넌트)에서도 Supabase Auth를 써야 하므로 동일한 값의
# NEXT_PUBLIC_ 버전이 필요하다. anon 키는 RLS로 보호되는 공개 키라 노출되어도 안전하다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings > Data API > service_role (secret!) — app/api/ 라우트 핸들러 전용, 절대 클라이언트에 노출 금지
SUPABASE_SERVICE_ROLE_KEY=

# LLM 호출 — 엘리스 mlapi 중계 서버 (OpenAI 호환 스펙: POST {LLM_BASE_URL}/chat/completions)
# 발급 페이지: https://yeardream2026.elice.io/cloud/mlapi/keys/...
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=claude-sonnet-5
